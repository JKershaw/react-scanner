{
  "name": "react-flowchart-generator",
  "version": "2.0.0",
  "description": "Generate interactive flowcharts from React applications by analyzing React Router configurations and navigation components",
  "type": "module",
  "main": "src/cli/index.js",
  "bin": {
    "react-flowchart": "src/cli/index.js"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:core": "node --test test/core/*.test.js",
    "test:ui": "node --test test/ui/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "start": "node src/cli/index.js",
    "dev": "vite",
    "dev:api": "node src/server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "flowchart",
    "visualization",
    "react-router",
    "navigation",
    "ast",
    "mermaid",
    "testing",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@dagrejs/dagre": "^1.0.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}
